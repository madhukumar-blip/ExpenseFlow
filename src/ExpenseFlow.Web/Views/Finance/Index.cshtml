@model System.Collections.Generic.IReadOnlyList<ExpenseFlow.Application.Expenses.FinanceExpenseItem>
@using System.Globalization

@{
    ViewData["Title"] = "Reimbursements";
    var culture = CultureInfo.GetCultureInfo("en-IN");
}

<h1>Reimbursements</h1>
<p class="text-muted">
    Record completed payments for approved expenses.
    Oldest 100 approvals first.
</p>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body py-5 text-center">
            <h2 class="h4">No expenses awaiting reimbursement</h2>
            <p class="text-muted mb-0">
                Approved expenses from other employees will appear here.
            </p>
        </div>
    </div>
}
else
{
    @foreach (var expense in Model)
    {
        <article class="card shadow-sm mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <h2 class="h5">@expense.Title</h2>
                        <p class="text-muted">@expense.EmployeeEmail</p>
                    </div>

                    <strong class="fs-5 text-nowrap">
                        @expense.Amount.ToString("C2", culture)
                    </strong>
                </div>

                <p class="small text-muted">
                    Approved:
                    @(expense.ApprovedAtUtc?.ToString(
                        "dd MMM yyyy HH:mm 'UTC'", culture) ?? "Unavailable")
                </p>
                @if (!string.IsNullOrWhiteSpace(
    expense.ReceiptOriginalFileName))
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <div class="small text-muted">Receipt evidence</div>
                                <div class="fw-semibold text-break">
                                    @expense.ReceiptOriginalFileName
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="PreviewReceipt"
                                   asp-route-id="@expense.Id"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-sm btn-outline-primary">
                                    Preview
                                </a>

                                <a asp-action="DownloadReceipt"
                                   asp-route-id="@expense.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Download
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2">
                        No receipt evidence is available.
                    </div>
                }
                <form asp-action="Reimburse" method="post">
                    <input type="hidden"
                           name="Id"
                           value="@expense.Id" />

                    <input type="hidden"
                           name="RowVersion"
                           value="@Convert.ToBase64String(expense.RowVersion)" />

                    <div class="mb-3">
                        <label for="payment-@expense.Id" class="form-label">
                            Payment reference
                        </label>

                        <input id="payment-@expense.Id"
                               name="PaymentReference"
                               class="form-control"
                               maxlength="100"
                               required
                               placeholder="Bank or payment transaction reference" />
                    </div>

                    <button type="submit" class="btn btn-success">
                        Record reimbursement
                    </button>
                </form>
            </div>
        </article>
    }
}