@model System.Collections.Generic.IReadOnlyList<ExpenseFlow.Application.Expenses.ExpenseStatusSummary>
@using System.Globalization
@using ExpenseFlow.Domain.Enums

@{
    ViewData["Title"] = "Dashboard";
    var culture = CultureInfo.GetCultureInfo("en-IN");
    var totalCount = Model.Sum(item => item.Count);
    var totalAmount = Model.Sum(item => item.TotalAmount);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>My expense dashboard</h1>
        <p class="text-muted mb-0">
            All your expenses, grouped by their current status.
        </p>
    </div>

    <a asp-controller="Expenses"
       asp-action="Create"
       class="btn btn-primary">
        Create expense
    </a>
</div>

<div class="card bg-dark text-white mb-4">
    <div class="card-body p-4">
        <p class="mb-1">Total expense value — all statuses</p>
        <h2>@totalAmount.ToString("C2", culture)</h2>
        <p class="mb-0">@totalCount expense(s)</p>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var item in Model)
    {
        var description = item.Status switch
        {
            ExpenseStatus.Draft => "Ready to edit or submit",
            ExpenseStatus.Submitted => "Awaiting manager review",
            ExpenseStatus.Approved => "Awaiting reimbursement",
            ExpenseStatus.Rejected => "Rejected by a manager",
            ExpenseStatus.Reimbursed => "Reimbursement recorded",
            _ => ""
        };

        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">@item.Status</h2>
                    <p class="fs-4 fw-semibold mb-1">
                        @item.TotalAmount.ToString("C2", culture)
                    </p>
                    <p class="mb-1">@item.Count expense(s)</p>
                    <p class="small text-muted mb-0">@description</p>
                </div>
            </div>
        </div>
    }
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Expenses"
       asp-action="Index"
       class="btn btn-outline-primary">
        View my expenses
    </a>

    @if (User.IsInRole("Manager"))
    {
        <a asp-controller="Approvals"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Review approvals
        </a>
    }

    @if (User.IsInRole("Finance"))
    {
        <a asp-controller="Finance"
           asp-action="Index"
           class="btn btn-outline-success">
            Record reimbursements
        </a>
    }
</div>