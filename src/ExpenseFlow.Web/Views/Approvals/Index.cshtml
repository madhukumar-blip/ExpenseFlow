@model System.Collections.Generic.IReadOnlyList<ExpenseFlow.Application.Expenses.PendingExpenseItem>
@using System.Globalization

@{
    ViewData["Title"] = "Pending approvals";
    var culture = CultureInfo.GetCultureInfo("en-IN");
}

<h1>Pending approvals</h1>
<p class="text-muted">
    Review submitted expenses. Oldest 100 requests first.
</p>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">
        @success
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-warning" role="alert">
        @error
    </div>
}

@if (Model.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body py-5 text-center">
            <h2 class="h4">No expenses waiting for review</h2>
            <p class="text-muted mb-0">
                Submitted expenses from other employees will appear here.
            </p>
        </div>
    </div>
}
else
{
    @foreach (var expense in Model)
    {
        <article class="card shadow-sm mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <h2 class="h5">@expense.Title</h2>
                        <p class="text-muted mb-1">
                            @expense.EmployeeEmail
                        </p>
                        <p class="text-muted">
                            @expense.Category ·
                            @expense.ExpenseDate.ToString("dd MMM yyyy", culture)
                        </p>
                    </div>

                    <strong class="fs-5 text-nowrap">
                        @expense.Amount.ToString("C2", culture)
                    </strong>
                </div>

                <p>@expense.Description</p>
                @if (!string.IsNullOrWhiteSpace(
    expense.ReceiptOriginalFileName))
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <div class="small text-muted">Receipt evidence</div>
                                <div class="fw-semibold text-break">
                                    @expense.ReceiptOriginalFileName
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="PreviewReceipt"
                                   asp-route-id="@expense.Id"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-sm btn-outline-primary">
                                    Preview
                                </a>

                                <a asp-action="DownloadReceipt"
                                   asp-route-id="@expense.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Download
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2">
                        No receipt was attached to this expense.
                    </div>
                }
                <form asp-controller="Approvals"
                      asp-action="Review"
                      method="post">

                    <input type="hidden"
                           name="Id"
                           value="@expense.Id" />

                    <input type="hidden"
                           name="RowVersion"
                           value="@Convert.ToBase64String(expense.RowVersion)" />

                    <div class="mb-3">
                        <label for="comment-@expense.Id"
                               class="form-label">
                            Manager comment
                        </label>

                        <textarea id="comment-@expense.Id"
                                  name="Comment"
                                  class="form-control"
                                  maxlength="1000"
                                  rows="3"
                                  placeholder="Optional for approval; required for rejection."></textarea>
                        <div class="invalid-feedback">
                            Enter a reason before rejecting this expense.
                        </div>
                        <div class="form-text">
                            Explain exceptions, required corrections, or approval notes.
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                name="Decision"
                                value="Approve"
                                class="btn btn-success">
                            Approve
                        </button>

                        <button type="submit"
                                name="Decision"
                                value="Reject"
                                class="btn btn-outline-danger">
                            Reject
                        </button>
                    </div>
                </form>
            </div>
        </article>
        @section Scripts {
            <script>
                document.querySelectorAll(
                    'form[action*="Review"]'
                ).forEach(function(form) {
                    const comment = form.querySelector(
                        'textarea[name="Comment"]'
                    );

                    comment.addEventListener("input", function() {
                        comment.classList.remove("is-invalid");
                    });

                    form.addEventListener("submit", function(event) {
                        const decision = event.submitter?.value;

                        if (decision === "Reject" &&
                            !comment.value.trim()) {
                            event.preventDefault();
                            comment.classList.add("is-invalid");
                            comment.focus();
                        }
                    });
                });
            </script>
        }
    }
}