@model ExpenseFlow.Web.Models.Expenses.EditExpenseViewModel
@using ExpenseFlow.Domain.Enums

@{
    ViewData["Title"] = "Edit expense";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1>Edit expense</h1>

                <p class="text-muted mb-1">
                    Update this draft before submitting it for approval.
                </p>

                <p class="small text-muted mb-0">
                    Receipt files are managed from the expense details page.
                </p>
            </div>

            <span class="badge bg-secondary">Draft</span>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Expenses"
                      asp-action="Edit"
                      method="post">

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="RowVersion" type="hidden" />

                    <div asp-validation-summary="All"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title"
                               class="form-label"></label>

                        <input asp-for="Title"
                               class="form-control"
                               maxlength="150"
                               autocomplete="off" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount"
                                   class="form-label"></label>

                            <input asp-for="Amount"
                                   type="number"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01" />

                            <span asp-validation-for="Amount"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpenseDate"
                                   class="form-label"></label>

                            <input asp-for="ExpenseDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="ExpenseDate"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Category"
                               class="form-label"></label>

                        <select asp-for="Category"
                                asp-items="Html.GetEnumSelectList<ExpenseCategory>()"
                                class="form-select">
                            <option value="">Select a category</option>
                        </select>

                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Save changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                    <p class="small text-muted">
                        Receipt files are managed from the expense details page.
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}