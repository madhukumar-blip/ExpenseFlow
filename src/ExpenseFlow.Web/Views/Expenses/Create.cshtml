@model ExpenseFlow.Web.Models.Expenses.CreateExpenseViewModel
@using ExpenseFlow.Domain.Enums

@{
    ViewData["Title"] = "Create expense";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1>Create expense</h1>
            <p class="text-muted">
                Enter your business expense details.
                Your expense will be saved as a draft.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Expenses"
                      asp-action="Create"
                      method="post">

                    <div asp-validation-summary="All"
                         class="text-danger"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title"
                               class="form-label"></label>

                        <input asp-for="Title"
                               class="form-control"
                               maxlength="150"
                               placeholder="Example: Client meeting travel" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Explain the business purpose.">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount"
                                   class="form-label"></label>

                            <input asp-for="Amount"
                                   type="number"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01" />

                            <span asp-validation-for="Amount"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpenseDate"
                                   class="form-label"></label>

                            <input asp-for="ExpenseDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="ExpenseDate"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Category"
                               class="form-label"></label>

                        <select asp-for="Category"
                                asp-items="Html.GetEnumSelectList<ExpenseCategory>()"
                                class="form-select">
                            <option value="">Select a category</option>
                        </select>

                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Save draft
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}