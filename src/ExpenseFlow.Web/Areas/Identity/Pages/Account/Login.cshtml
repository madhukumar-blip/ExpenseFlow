@page
@model ExpenseFlow.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<div class="ef-auth-shell">
    <partial name="_AuthBrand" />

    <section class="ef-auth-form-panel" aria-labelledby="login-heading">
        <div class="ef-auth-form-content">
            <span class="ef-auth-kicker">YOUR WORKSPACE</span>

            <h1 id="login-heading">Welcome back.</h1>

            <p class="ef-auth-subtitle">
                Sign in to manage your expenses and approvals.
            </p>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="ModelOnly"
                     class="ef-auth-errors"
                     role="alert"></div>

                <div class="ef-auth-field">
                    <label asp-for="Input.Email"></label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="you@company.com"
                           aria-describedby="login-email-error"
                           autofocus />

                    <span asp-validation-for="Input.Email"
                          id="login-email-error"></span>
                </div>

                <div class="ef-auth-field">
                    <label asp-for="Input.Password"></label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Enter your password"
                           aria-describedby="login-password-error" />

                    <span asp-validation-for="Input.Password"
                          id="login-password-error"></span>
                </div>

                <div class="form-check ef-auth-remember">
                    <input asp-for="Input.RememberMe"
                           class="form-check-input" />

                    <label asp-for="Input.RememberMe"
                           class="form-check-label">
                        Remember me
                    </label>
                </div>

                <button type="submit"
                        class="btn btn-primary ef-auth-submit">
                    Sign in to ExpenseFlow
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <div class="ef-auth-divider"></div>

            <p class="ef-auth-switch">
                New to ExpenseFlow?
                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Create an account
                </a>
            </p>

            <p class="ef-auth-note">
                Your workspace access is based on your assigned role.
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}